# ── Supabase ───────────────────────────────────────────────────────────────
# Project URL and keys from your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Anon / publishable key — safe to expose to the browser (used by auth + RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY. Bypasses RLS; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Claude (AI enrichment) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# CLAUDE_MODEL=claude-sonnet-4-20250514
# DIAGNOSE_PROMPT_VERSION=1
# ENABLE_AI_ENRICHMENT=true
